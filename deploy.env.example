# Deployment configuration template.
#
# Copy to deploy.env and fill in your own values:
#   cp deploy.env.example deploy.env && chmod 600 deploy.env
#
# deploy.env is gitignored. Never commit real secrets.

# --- Target ---
# Container/image name, also used to derive the remote paths below.
APP_NAME="leagr"
# An SSH alias defined in ~/.ssh/config. Keeping the real hostname, user, port
# and key path in your SSH config (not here) means this file stays free of
# anything routable.
REMOTE_HOST="your-ssh-alias"
# Remote directories. The deploy scripts target a Windows (cmd.exe) host, hence
# the drive-letter paths; adjust for your own host.
REMOTE_DEPLOY_DIR="C:/$APP_NAME/docker"
REMOTE_DATA_DIR="C:/$APP_NAME/data"
REMOTE_LOGS_DIR="C:/$APP_NAME/logs"
# Host port published to the container's port 3000.
PORT=3000

# --- App runtime environment ---
# Comma-separated CORS whitelist; supports wildcards.
ALLOWED_ORIGIN="https://your-domain.example,https://localhost:3000"
APP_URL="https://your-domain.example"
# Signs the HttpOnly _ls session cookie. Use a long random value.
SESSION_SECRET=""
# 6MB, sized for avatar uploads.
BODY_SIZE_LIMIT=6291456
# debug | info | warn | error
LOG_LEVEL=info

# Optional. Salt for HMAC player-ownership hashing; falls back to APP_URL when
# unset (see src/lib/server/playerAccessControl.js).
# WARNING: setting or changing this invalidates every existing stored ownerId,
# so current owners lose the ability to rename/remove themselves. Leave empty on
# an existing install unless you intend that migration.
PLAYER_OWNER_SALT=""

# --- Email ---
MAILGUN_SENDING_KEY=""
MAILGUN_DOMAIN="mail.your-domain.example"

# --- AI team logos (optional; logo generation is skipped without a key) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-image-1.5"

# --- Local dev data sync (copy-live-data.sh) ---
DEFAULT_LEAGUE="your-league"
